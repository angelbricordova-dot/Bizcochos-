# Contraseña para entrar a la app (la defines tú en Vercel → Settings → Environment Variables)
APP_PASSWORD=
# Opcional: clave larga y aleatoria para firmar la sesión. Si no la pones se deriva de APP_PASSWORD.
SESSION_SECRET=
# Las pone solas la integración de Upstash Redis en Vercel (Storage → Upstash → Redis):
KV_REST_API_URL=
KV_REST_API_TOKEN=
